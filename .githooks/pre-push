#!/usr/bin/env bash
#
# pre-push: the FULL tier — the gate, on the tree you are about to publish.
#
# from AI-DEV-STARTER (plunk-in kit) — if you edit this file, say why in INCIDENTS.md.
# Install as .githooks/pre-push and arm it once per clone:
#
#     git config core.hooksPath .githooks
#
# For C++ it also requires a clean worktree and proves the COMMITTED tree is complete
# by building and testing a pristine checkout of HEAD. For deno/python the same script
# is already the whole gate and already includes its own clean-checkout story.
#
# Deliberate bypass when you need one:  git push --no-verify
#
set -uo pipefail

root=$(git rev-parse --show-toplevel) || exit 1

if [ -x "$root/tools/ci.sh" ]; then
    # COMPUTO: the full tier runs every stage the kit ships, plus this repo's own `release`
    # and `docs` stages. tidy joined the list on 2026-09-20, when .clang-tidy stopped analysing
    # the FetchContent'd JSOM headers and the 66 findings left in this repo's own sources were
    # fixed; release joined it the same day, when it turned out that no stage here configured
    # an optimized build at all, while the optimized configurations this repo is built in -
    # ./build.sh (Release) and an optimized consumer, jsonTools - both use one; docs joined the
    # same day too, because the documentation pipeline (66 executed examples, coverage, the
    # generated reference and indexes) had only ever run in .github/workflows/docs.yml and 14
    # examples plus the published reference had been wrong since 2026-02-10 (tools/ci.sh and
    # INCIDENTS.md have the measurements). The list mirrors CI_DEFAULT_STAGES in tools/ci.sh;
    # keep the two in step.
    exec "$root/tools/ci.sh" \
        --require-clean \
        tree format kitprobes build tests docs release version asan tsan tidy pristine
fi

if [ -x "$root/scripts/gate.sh" ]; then
    exec "$root/scripts/gate.sh"
fi

printf 'pre-push: no gate found. Expected %s/tools/ci.sh (C++) or %s/scripts/gate.sh (deno/python).\n' \
    "$root" "$root" >&2
exit 1
