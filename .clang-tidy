# clang-tidy configuration — the `tidy` stage of tools/ci.sh (and the `lint`/`quality`
# CMake targets).
#
# VALUE-ONLY CHECK SET, the same one JSOM and jsonTools use, and for the same measured
# reason: the stock families (-*,bugprone-*,performance-*,readability-*,modernize-*,
# portability-*) produced 430 findings on this repo's own sources — 142 of them
# readability-magic-numbers (mostly test data), 55 readability-braces-around-statements and
# 32 readability-identifier-length. That is style, and .clang-format plus review already
# own it; reported as 430 defects it makes the gate red on day one, and a gate that is red
# on day one gets ignored. What is left below is real bug patterns and performance.
Checks: '-*,bugprone-*,-bugprone-easily-swappable-parameters,performance-*'

# HeaderFilterRegex decides which INCLUDED files get reported. It must not match the
# FetchContent'd JSOM checkout: measured 2026-09-19, the old pattern
# '^.*/(src|include)/.*\.(hpp|cpp)$' matched build/_deps/jsom-src/include/... and produced
# 5178 of 5601 findings (115 distinct, re-reported once per translation unit) in code this
# repo cannot fix. A positive pattern for this repo's own tree is the fix — LLVM's regex has
# no negative lookahead, so "anything but _deps" cannot be expressed directly.
#
# Paths in the compilation database are absolute and matched as substrings, so
# "Computo/src/" cannot appear in a JSOM path. Diagnostics in the analysed .cpp itself are
# reported regardless of this filter, so a clone under a different directory name still gets
# its own source findings — only header findings would be lost.
HeaderFilterRegex: 'Computo/(src|include|tests)/.*\.(hpp|cpp)$'

CheckOptions:
  # The knobs below configure readability/modernize checks that the curated set above turns
  # OFF. They are kept on purpose — if someone re-enables those families, the tuning that
  # made them usable is still here — and they are inert while the families are off.
  - key: readability-function-cognitive-complexity.IgnoreMacros
    value: true
  - key: readability-function-cognitive-complexity.Threshold
    value: 30
  - key: readability-function-size.LineThreshold
    value: 30
  - key: modernize-use-trailing-return-type.UseTrailingReturnType
    value: true
  # Empty catches that are deliberate. tests/test_debug_integration.cpp catches
  # DebugBreakException to record "the breakpoint fired", which is the point of those tests,
  # and the body is empty because there is nothing to do. Naming the type here keeps the
  # check ARMED for every other empty catch, where swallowing an error is a real bug — which
  # is why this is a CheckOption and not a NOLINT at the site.
  - key: bugprone-empty-catch.AllowEmptyCatchForExceptions
    value: computo::DebugBreakException
